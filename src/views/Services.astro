---
import Base from '~/layouts/Base.astro';
import Section from '~/components/Section.astro';
import Contact from '~/components/Contact.astro';
import { principles, services } from '~/content/site';
import { projects } from '~/content/projects';
import { localizePath, t, type Locale } from '~/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const title = locale === 'uk' ? 'Співпраця · sp1le' : 'Working together · sp1le';
const description =
  locale === 'uk'
    ? 'Зібрати продукт від схеми до сервера або долучитися інженером до команди. Як я працюю і чого не беру.'
    : 'Build a product from schema to server, or join a team as an engineer. How I work, and what I turn down.';

const live = projects.filter((p) => p.status === 'live');
---

<Base locale={locale} title={title} description={description} path="/services">
  <div class="mx-auto max-w-[78rem] px-5 sm:px-8">
    <section class="pt-16 pb-10 sm:pt-24 sm:pb-14">
      <p class="tick lift text-soft">{t.navServices[locale]}</p>
      <h1 class="lift mt-6 max-w-[16ch] text-mega font-display font-semibold text-ink" style="animation-delay: 60ms">
        {t.servicesTitle[locale]}
      </h1>
      <p class="lift mt-8 max-w-2xl text-base leading-relaxed text-soft sm:text-lg" style="animation-delay: 110ms">
        {t.servicesLede[locale]}
      </p>
    </section>

    <div class="space-y-20 sm:space-y-28">
      {
        services.map((offer) => (
          <Section label={offer.rail[locale]}>
            <div class="border-t border-rule pt-5">
              <h2 class="text-title font-display font-semibold text-ink">{offer.title[locale]}</h2>
              <p class="measure mt-5 leading-relaxed text-soft">{offer.body[locale]}</p>

              <dl class="mt-8 grid gap-x-8 gap-y-6 sm:grid-cols-2">
                <div>
                  <dt class="tick text-ink">{locale === 'uk' ? 'Кому підходить' : 'Good fit'}</dt>
                  <dd class="mt-2 text-sm leading-relaxed text-soft">{offer.suits[locale]}</dd>
                </div>
                <div>
                  <dt class="tick text-flag">{locale === 'uk' ? 'Кому ні' : 'Wrong fit'}</dt>
                  <dd class="mt-2 text-sm leading-relaxed text-soft">{offer.notFor[locale]}</dd>
                </div>
              </dl>
            </div>
          </Section>
        ))
      }

      <Section
        label={t.railMethod[locale]}
        notes={[locale === 'uk' ? 'три правила, які видно в кожному кейсі' : 'three rules visible in every case study']}
      >
        <h2 class="text-title font-display font-semibold text-ink">
          {locale === 'uk' ? 'Як я працюю' : 'How I work'}
        </h2>

        <ol class="mt-10 space-y-8">
          {
            principles.map((principle) => (
              <li class="border-t border-rule pt-5">
                <h3 class="font-display text-head font-semibold text-ink">{principle.title[locale]}</h3>
                <p class="measure mt-3 leading-relaxed text-soft">{principle.body[locale]}</p>
              </li>
            ))
          }
        </ol>
      </Section>

      <Section label={t.railProof[locale]}>
        <h2 class="text-title font-display font-semibold text-ink">{t.proofTitle[locale]}</h2>
        <p class="measure mt-4 text-soft">
          {
            locale === 'uk'
              ? 'Найкоротший спосіб оцінити мене - відкрити те, що вже працює, і подивитися, як воно поводиться.'
              : 'The shortest way to judge me is to open something that is already running and see how it behaves.'
          }
        </p>
        <ul class="mt-6 space-y-3">
          {
            live.map((project) => (
              <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-t border-rule pt-3">
                <a href={localizePath(`/work/${project.slug}`, locale)} class="link-quiet font-display font-semibold">
                  {project.name}
                </a>
                <a href={project.href} target="_blank" rel="noopener noreferrer" class="font-mono text-xs text-signal hover:opacity-70">
                  {project.hrefLabel}
                </a>
                <span class="text-sm text-faint">{project.kind[locale]}</span>
              </li>
            ))
          }
        </ul>
      </Section>

      <Contact locale={locale} />
    </div>
  </div>
</Base>
