---
import Base from '~/layouts/Base.astro';
import Section from '~/components/Section.astro';
import StatusTag from '~/components/StatusTag.astro';
import Contact from '~/components/Contact.astro';
import { projects } from '~/content/projects';
import { localizePath, t, type Locale } from '~/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const title = locale === 'uk' ? 'Роботи · sp1le' : 'Work · sp1le';
const description =
  locale === 'uk'
    ? "П'ять систем із журналом рішень, заміряними цифрами та чесною ретроспективою."
    : 'Five systems, each with a decision record, measured numbers and an honest retrospective.';
---

<Base locale={locale} title={title} description={description} path="/work">
  <div class="mx-auto max-w-[78rem] px-5 sm:px-8">
    <section class="pt-16 pb-10 sm:pt-24 sm:pb-14">
      <p class="tick lift text-soft">{t.workTitle[locale]}</p>
      <h1 class="lift mt-6 max-w-[16ch] text-mega font-display font-semibold text-ink" style="animation-delay: 60ms">
        {locale === 'uk' ? 'Роботи, з ходом міркувань' : 'Work, with the reasoning left in'}
      </h1>
      <p class="lift mt-8 max-w-2xl text-base leading-relaxed text-soft sm:text-lg" style="animation-delay: 110ms">
        {t.workLede[locale]}
      </p>
    </section>

    <div class="space-y-20 sm:space-y-28">
      {
        projects.map((project) => (
          <Section
            label={project.kind[locale]}
            notes={[project.period, project.runtime]}
            as="article"
          >
            <a href={localizePath(`/work/${project.slug}`, locale)} class="group block border-t border-rule pt-5">
              <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                <StatusTag status={project.status} locale={locale} />
                {project.hrefLabel && <span class="font-mono text-xs text-faint">{project.hrefLabel}</span>}
              </div>

              <h2 class="mt-4 text-title font-display font-semibold text-ink transition-colors group-hover:text-signal">
                {project.name}
              </h2>

              <p class="measure mt-4 leading-relaxed text-soft">{project.summary[locale]}</p>

              <p class="measure mt-4 border-s-2 border-rule ps-4 text-sm leading-relaxed text-faint">
                {project.constraint[locale]}
              </p>

              <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2">
                <span class="tick text-signal transition-opacity group-hover:opacity-70">
                  {t.caseDecisions[locale]} →
                </span>
                <span class="tick text-faint">
                  {project.decisions.length} {locale === 'uk' ? 'записів' : 'records'}
                </span>
                <span class="tick text-faint">
                  {project.metrics[0]?.value} {project.metrics[0]?.label[locale]}
                </span>
              </div>
            </a>
          </Section>
        ))
      }

      <Contact locale={locale} />
    </div>
  </div>
</Base>
