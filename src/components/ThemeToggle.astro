---
import { t, type Locale } from '~/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  class="ms-1 rounded p-1.5 text-soft transition-colors hover:bg-sunk hover:text-ink"
  aria-label={t.toggleTheme[locale]}
  title={t.toggleTheme[locale]}
>
  {/* Dark is the default, so the sun (switch to light) shows first. Swapped by CSS: no icon flash on load. */}
  <svg class="size-4 icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg class="size-4 icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z"></path>
  </svg>
</button>

<style>
  .icon-moon {
    display: none;
  }

  :global(:root[data-theme='light']) .icon-moon {
    display: block;
  }

  :global(:root[data-theme='light']) .icon-sun {
    display: none;
  }
</style>

<script>
  const root = document.documentElement;
  const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

  const current = (): 'light' | 'dark' => (root.getAttribute('data-theme') === 'light' ? 'light' : 'dark');

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    button.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      if (themeColor) themeColor.content = next === 'light' ? '#f2f3f6' : '#1a1c24';
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* storage blocked: the choice simply does not survive the session */
      }
    });
  }
</script>
