---
import { t, type Locale } from '~/lib/i18n';

/**
 * The headline, drawn: schema -> service -> unit -> edge -> user.
 * Every value here is a real thing from the VPS this site is served from.
 */
interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className = '' } = Astro.props;

const nodes = [
  { key: 'schema', value: 'Postgres / SQLite', meta: '25 migrations' },
  { key: 'service', value: 'FastAPI / Node', meta: '110 routes' },
  { key: 'unit', value: 'systemd', meta: '3 services · 1 VPS' },
  { key: 'edge', value: 'nginx', meta: '4 vhosts · TLS' },
  { key: 'user', value: locale === 'uk' ? 'Telegram / браузер' : 'Telegram / browser', meta: 'Mini App · web' },
];

/** 600 ms per hop; the node's pulse is timed to the packet's arrival. */
const HOP = 0.6;
---

<figure class:list={['lift', className]} style="animation-delay: 220ms" aria-label={t.pipelineAria[locale]}>
  <ol class="pipe" aria-hidden="true">
    {
      nodes.map((node, i) => (
        <>
          {i > 0 && (
            <li class="pipe-edge" style={`--delay: ${((i - 1) * HOP).toFixed(1)}s`}>
              <i class="pipe-packet"></i>
            </li>
          )}
          <li class="pipe-node" style={`--delay: ${(i * HOP).toFixed(1)}s`}>
            <span class="tick block text-signal">{node.key}</span>
            <span class="mt-1.5 block font-display text-[0.95rem] font-semibold leading-tight text-ink">{node.value}</span>
            <span class="mt-1 block truncate font-mono text-[0.6875rem] text-faint">{node.meta}</span>
          </li>
        </>
      ))
    }
  </ol>
  <figcaption class="tick mt-4 text-faint">{t.pipelineCaption[locale]}</figcaption>
</figure>
