---
import type { Status } from '~/content/projects';
import { t, type Locale } from '~/lib/i18n';

interface Props {
  status: Status;
  locale: Locale;
  class?: string;
}

const { status, locale, class: className = '' } = Astro.props;

/**
 * Colour is the status. Live work is the one thing on the page allowed to use
 * the signal colour; unfinished work carries the flag; handed-over work is grey
 * because it is no longer mine to advertise.
 */
const styles: Record<Status, { tone: string; dot: string; label: string; pulse: boolean }> = {
  live: { tone: 'text-signal', dot: 'bg-signal', label: t.statusLive[locale], pulse: true },
  building: { tone: 'text-flag', dot: 'bg-flag', label: t.statusBuilding[locale], pulse: false },
  prototype: { tone: 'text-flag', dot: 'bg-flag', label: t.statusPrototype[locale], pulse: false },
  handedOver: { tone: 'text-faint', dot: 'bg-faint', label: t.statusHandedOver[locale], pulse: false },
};

const s = styles[status];
---

<span class:list={['tick inline-flex items-center gap-2 whitespace-nowrap', s.tone, className]}>
  <span class="relative flex size-1.5 shrink-0">
    {s.pulse && <span class:list={['absolute inline-flex size-full animate-ping rounded-full opacity-60', s.dot]} />}
    <span class:list={['relative inline-flex size-1.5 rounded-full', s.dot]}></span>
  </span>
  {s.label}
</span>
