---
import Section from '~/components/Section.astro';
import { site } from '~/content/site';
import { t, type Locale } from '~/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<Section id="contact" label={t.navContact[locale]} notes={[site.role[locale]]}>
  <h2 class="text-title font-display font-semibold text-ink">{t.contactTitle[locale]}</h2>
  <p class="measure mt-4 text-soft">{t.contactLede[locale]}</p>

  <div class="mt-8 flex flex-wrap items-center gap-3">
    <a
      href={`mailto:${site.email}`}
      class="inline-flex h-11 items-center rounded-sm bg-ink px-5 font-mono text-sm font-semibold text-paper transition-opacity hover:opacity-85"
    >
      {site.email}
    </a>

    <button
      type="button"
      data-copy={site.email}
      class="inline-flex h-11 items-center rounded-sm border border-rule px-5 font-mono text-sm text-soft transition-colors hover:border-ink hover:text-ink"
    >
      <span data-copy-idle>{t.copyEmail[locale]}</span>
      <span data-copy-done hidden>{t.copied[locale]}</span>
    </button>

    <a
      href={site.github}
      rel="me noopener"
      class="inline-flex h-11 items-center rounded-sm border border-rule px-5 font-mono text-sm text-soft transition-colors hover:border-ink hover:text-ink"
    >
      {site.githubLabel}
    </a>
  </div>
</Section>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const idle = button.querySelector<HTMLElement>('[data-copy-idle]');
    const done = button.querySelector<HTMLElement>('[data-copy-done]');
    if (!idle || !done) continue;

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset['copy'] ?? '');
      } catch {
        return; // No clipboard permission: the address is a visible link next to this button anyway.
      }
      idle.hidden = true;
      done.hidden = false;
      window.setTimeout(() => {
        idle.hidden = false;
        done.hidden = true;
      }, 1800);
    });
  }
</script>
