---
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import { site } from '~/content/site';
import { DEFAULT_LOCALE, LOCALE_META, LOCALES, localizePath, stripLocale, t, type Locale } from '~/lib/i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Path without locale prefix, e.g. "/work/sonar". Used for hreflang alternates. */
  path: string;
  ogImage?: string;
}

const { locale, title, description, path, ogImage = '/og.png' } = Astro.props;

const meta = LOCALE_META[locale];
const canonicalPath = localizePath(path, locale);
const canonical = new URL(canonicalPath, site.url).href;
const bare = stripLocale(path);

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.person,
  alternateName: site.name,
  url: site.url,
  email: `mailto:${site.email}`,
  jobTitle: site.role[locale],
  sameAs: [site.github, site.telegram],
  knowsAbout: ['Python', 'FastAPI', 'PostgreSQL', 'TypeScript', 'React', 'Node.js', 'Unity', 'C#', 'Telegram Bot API'],
};
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {
      LOCALES.map((alt) => (
        <link
          rel="alternate"
          hreflang={LOCALE_META[alt].htmlLang}
          href={new URL(localizePath(bare, alt), site.url).href}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(localizePath(bare, DEFAULT_LOCALE), site.url).href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site.url).href} />
    <meta property="og:locale" content={locale === 'uk' ? 'uk_UA' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1a1c24" />

    <link rel="preload" href="/fonts/plex-sans-latin-3.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geologica-latin-3.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline set:html={JSON.stringify(personLd)} type="application/ld+json" />

    {/* Dark is the default; a stored light choice is applied before first paint so nothing flashes. */}
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('theme') === 'light') {
            document.documentElement.setAttribute('data-theme', 'light');
            var m = document.querySelector('meta[name="theme-color"]');
            if (m) m.content = '#f2f3f6';
          }
        } catch (e) {
          /* private mode or blocked storage: stay on the default */
        }
      })();
    </script>
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded focus:bg-ink focus:px-4 focus:py-2 focus:font-mono focus:text-sm focus:text-paper"
    >
      {t.skipToContent[locale]}
    </a>

    <Header locale={locale} path={bare} />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer locale={locale} />

    <script>
      // The rail tick of the section under the reader's eye lights up. A narrow
      // band around 40% of the viewport decides which section that is.
      const rails = document.querySelectorAll<HTMLElement>('.rail');
      if (rails.length > 0 && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) entry.target.classList.toggle('is-active', entry.isIntersecting);
          },
          { rootMargin: '-38% 0px -52% 0px', threshold: 0 },
        );
        rails.forEach((rail) => observer.observe(rail));
      }
    </script>
  </body>
</html>
